# --- API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
UNIPILE_API_KEY=your_unipile_api_key_here

# --- Environment Settings ---
ALLOWED_ORIGINS=*
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4-turbo-preview
DEBUG_LOG_PATH=/tmp/debug_sync.log

# --- Exa sourcing (core/sourcing_config.py) ---
# EXA_API_KEY=
# Pass B (Exa Agent deep-search sweep) and the per-URL get_contents() deep
# analysis are both paid and both OFF by default. Turn them on together or
# not at all: Pass B off + deep analysis on still pays per profile.
# EXA_AGENT_ENABLED=false
# EXA_DEEP_ANALYSIS_ENABLED=false
# Spend telemetry (services/exa_telemetry.py): a New Relic ExaCall event per
# Exa call (cost, outcome; ids and enums only) and an hourly ExaConfig per worker.
# EXA_TELEMETRY_ENABLED=true
# Tag contact Agent runs with `metadata` (env, surface, tier, trigger, job_id,
# call_id) for scripts/exa_runs_ledger.py. A run refused for it (400) is re-sent
# once without it, and the worker stops sending it (logged at ERROR).
# EXA_RUN_METADATA_ENABLED=true
# Out-of-credits breaker: after a 402 NO_MORE_CREDITS / API_KEY_BUDGET_EXCEEDED /
# TEAM_BUDGET_EXCEEDED, every worker skips Exa for this many seconds (Redis
# key vendor:exa:no_credits:<env>). 0 = off.
# VENDOR_EXA_NO_CREDITS_TTL_S=300
# Pass A / Dice people search: each title query buys ceil(50 * F / queries)
# results (at least 10, at most 50), 34 for 3 titles at F=2. 0 = 50 each again.
# EXA_PEOPLE_PER_QUERY_FACTOR=2.0
# Pass A / Dice search cache (services/exa_search_cache.py): each query's
# results are kept in Redis, encrypted, for this many seconds, so sample, full,
# relaxation and resumed runs reuse them. Needs REDIS_URL. 0 = off.
# EXA_SEARCH_CACHE_TTL_S=43200

# --- Contact lookups (cheapest first; services/contact_enrichment.py) ---
# Providers asked, in the fixed order kipplo, zoominfo, apollo, exa. Default
# (2026-09-29): Apollo and Exa only.
# CONTACT_LOOKUP_PROVIDERS=apollo,exa
# Exa: the normal agent run, then a deep search for what it did not find
# (Launch PAIR / phone button). "off" disables the deep search.
# EXA_CONTACT_ENRICH_EFFORT=low
# EXA_CONTACT_DEEP_EFFORT=medium
# EXA_CONTACT_DEEP_TIMEOUT_S=240
# Exa Connect data partners the deep search may call (Fiber.ai's people
# database, billed per Fiber credit on top of the run); empty = web only.
# EXA_CONTACT_DEEP_DATA_SOURCES=fiber
# Person-level contact cache (services/contact_cache.py; read at call time).
# Found contact is reused for good (0 = never expires; a number of days brings
# a TTL back). A deep-search miss is final for 180 days: Launch PAIR and
# sourcing never re-buy it from Exa (the on-demand chain still asks Kipplo,
# ZoomInfo and Apollo), a click shows "Searched <date>, nothing found" and
# re-buys only on "Search again". A normal-run miss sends the next lookup
# straight to the deep search for 30 days (and, while Exa runs with the deep
# search off, is final for the 180). 0 = that kind of miss is not honoured.
# CONTACT_CACHE_HIT_TTL_DAYS=0
# CONTACT_CACHE_DEEP_MISS_TTL_DAYS=180
# CONTACT_CACHE_MISS_TTL_DAYS=30
# false = a click re-buys a final miss without asking (the 2026-09-28 rule).
# CONTACT_CLICK_HONOUR_DEEP_MISS=true
# One paid Exa lookup per person at a time across the workers: a lookup of
# someone already being looked up waits for (polls) that run instead of buying
# its own; a run whose watcher dies with its worker is adopted by a 60 s sweep.
# A lease on the person's contact_enrichment_cache row (fails open). false =
# every lookup buys its own run, as before.
# CONTACT_LOOKUP_SINGLE_FLIGHT=true

# --- Kipplo Contact Enrichment (by LinkedIn URL; services/kipplo.py) ---
# Off unless "kipplo" is in CONTACT_LOOKUP_PROVIDERS. Keep the two rate knobs
# in step with the key's limits in the Kipplo portal (defaults 1/s, 10/min).
KIPPLO_API_KEY=
# KIPPLO_CONTACT_ENRICH_ENABLED=true
# KIPPLO_RATE_LIMIT_PER_SECOND=1
# KIPPLO_RATE_LIMIT_PER_MINUTE=10
# KIPPLO_MAX_WAIT_S=30
# Profiles per request for lookups waiting together (the limits count requests).
# 1 = off (default): our integration answers one profile per request; set 10
# once Kipplo raises its maximum result size.
# KIPPLO_BATCH_SIZE=1
# KIPPLO_BATCH_WINDOW_S=0.5

# --- ZoomInfo Contact Enrichment (off unless "zoominfo" is in CONTACT_LOOKUP_PROVIDERS) ---
ZOOMINFO_ENRICH_URL=https://api.zoominfo.com/enrich/contact
ZOOMINFO_BEARER_TOKEN=
ZOOMINFO_CLIENT_ID=

# --- Apollo Contact Enrichment (fallback when ZoomInfo returns no match) ---
# Leave blank to use the in-code legacy fallback key. Set to rotate.
APOLLO_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Optional. Per-worker psycopg2 pool size (default 8).
# DB_POOL_MAX=8
# Set both when DATABASE_URL points at PgBouncer (Azure Flexible Server :6432, transaction mode):
# DB_POOLER=pgbouncer
# DATABASE_URL_DIRECT=postgresql://user:pass@host:5432/db   # session advisory locks
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
# CLOUDSQL_CONNECTION_NAME=project:region:instance (optional)

# --- JobDiva ---
JOBDIVA_API_URL=https://api.jobdiva.com
JOBDIVA_CLIENT_ID=your_jobdiva_client_id_here
JOBDIVA_USERNAME=your_jobdiva_username_here
JOBDIVA_PASSWORD=your_jobdiva_password_here

# --- Unipile ---
UNIPILE_DSN=api1.unipile.com
UNIPILE_ACCOUNT_ID=your_unipile_account_id_here

# --- UDF IDs (Optional, defaults provided) ---
# JOBDIVA_AI_JD_UDF_ID=230
# JOBDIVA_JOB_NOTES_UDF_ID=231

# --- Encryption ---
ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_SALT=your_encryption_salt_here

# --- SMTP (shared — used by Tira bug reports AND PAIR email notifications) ---
# Leave blank to disable outbound emails; the API will still work normally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                       # Tira bug-report recipient only

# --- PAIR Email Notification Settings ---
PAIR_TEAM_EMAIL=pair-recruiting@pyramidci.com
JOB_POSTING_EMAIL=Jobposting@pyramidci.com
APP_BASE_URL=https://pairqa.pyramidci.com
PAIR_MANAGER_EMAIL_DOMAINS=pyramidci.com, celsiortech.com

# --- New Relic APM (core/newrelic.py; runbook docs/observability/new-relic.md) ---
# No key = agent off (every helper is a no-op). On QA/PROD deploy-azure.sh
# writes the key, app name and environment from deploy.yml when they are set.
NEW_RELIC_LICENSE_KEY=
# Kill switch: false turns the agent off before it is imported (also
# NEW_RELIC_MONITOR_MODE=false). Never written by deploys, so it survives them.
# NEW_RELIC_ENABLED=true
# local | qa | prod. Unset: APP_ENV / ENVIRONMENT / ENV, then the APP_BASE_URL
# host (pair.pyramidci.com -> prod, pairqa.pyramidci.com -> qa), else local.
# NEW_RELIC_ENVIRONMENT=local
# Default "PAIR API (QA)" / "PAIR API (PROD)" / "PAIR API (local)". Set only
# here or in the environment: newrelic.ini must not carry app_name.
# NEW_RELIC_APP_NAME="PAIR API (local)"
# Logs forwarded to NR: PROD WARNING, QA/local INFO by default; OFF disables.
# Messages are PII-scrubbed (emails, long digit runs) but INFO lines can name
# candidates.
# NEW_RELIC_LOG_FORWARD_LEVEL=INFO
# Seconds each worker waits for the collector at boot (0 = don't block).
# NEW_RELIC_STARTUP_TIMEOUT=0
# Run asyncio.to_thread work under the caller's trace (Postgres spans). off disables.
# NEW_RELIC_PROPAGATE_TO_THREAD=on
# Agent defaults set by core/newrelic.py; override only when debugging the agent:
# NEW_RELIC_LABELS=env:local;service:pair-api
# NEW_RELIC_LOG=stderr
# NEW_RELIC_LOG_LEVEL=warning
# Local runs that send nothing (agent behaviour tests use this):
# NEW_RELIC_DEVELOPER_MODE=true

# --- Server-driven Source & Launch: launch sessions (docs/launch-sessions.md) ---
# Both switches default (unset) to ON on QA and local and OFF on PROD (from
# NEW_RELIC_ENVIRONMENT / APP_ENV / ENVIRONMENT / ENV / the APP_BASE_URL host);
# an explicit true/false always wins. On the VMs they come from the GitHub
# environment variables of the same name (deploy.yml → deploy-azure.sh writes
# them here when set). PROD needs BOTH set to true.
# true: the Step-5 button creates a durable server launch session the API runs
# to the end; false: the legacy browser-driven flow. Gates creation only —
# sessions already created still finish and the browser still watches them.
# PAIR_SERVER_LAUNCH_ENABLED=true
# false: no worker claims sessions, and no new session is created (/config
# enabled=false, create → 503 disabled). Queued ones wait; see QUEUED_MAX_S.
# PAIR_LAUNCH_RUNNER_ENABLED=true
# Browser polling (GET /api/v1/launch-sessions/config): visible / hidden tab.
# PAIR_LAUNCH_POLL_MS=3000
# PAIR_LAUNCH_HIDDEN_POLL_MS=15000
# Lease: a claim lasts LEASE_S without a heartbeat (a SIGKILLed worker's
# sessions are adopted after that); heartbeat every HEARTBEAT_S.
# PAIR_LAUNCH_LEASE_S=180
# PAIR_LAUNCH_HEARTBEAT_S=30
# Ticker (claims only) and housekeeping (expiry, retention, re-checks).
# PAIR_LAUNCH_TICK_S=10
# PAIR_LAUNCH_HOUSEKEEPING_S=60
# Concurrency: live sessions across all workers — past their search (lookups,
# saves, Pairbot) / full searches still searching — and per worker; runner DB
# calls in flight per worker (HTTP keeps the rest of the pool).
# PAIR_LAUNCH_GLOBAL_CONCURRENCY=3
# PAIR_LAUNCH_SEARCH_CONCURRENCY=8
# PAIR_LAUNCH_WORKER_CONCURRENCY=1
# PAIR_LAUNCH_DB_CONCURRENCY=3
# Failed stage runs before a session fails (403s: before 'access revoked').
# PAIR_LAUNCH_MAX_ATTEMPTS=5
# PAIR_LAUNCH_ACCESS_DENIED_ATTEMPTS=3
# Work sizes: contact lookups in flight, /candidates/save batch, Pairbot batch.
# PAIR_LAUNCH_ENRICH_CONCURRENCY=20
# PAIR_LAUNCH_SAVE_BATCH=25
# PAIR_LAUNCH_BATCH_SIZE=75
# JobDiva provisioning (S7b): chunk size; tries per chunk before it is counted
# failed (provisioning never fails a session).
# PAIR_LAUNCH_PROVISION_CHUNK=25
# PAIR_LAUNCH_PROVISION_TRIES=3
# Pairbot resume: a posted row Pairbot has no record of is re-posted only after
# REPOST_AFTER_S; bulks younger than FRESH_BULK_S are not trusted as "own";
# ambiguous rows wait up to SETTLE_MAX_S, then count as unconfirmed.
# PAIR_LAUNCH_REPOST_AFTER_S=600
# PAIR_LAUNCH_FRESH_BULK_S=30
# PAIR_LAUNCH_SETTLE_WAIT_S=45
# PAIR_LAUNCH_SETTLE_MAX_S=1800
# Expiry / retention: abandoned uploads, never-started queued sessions
# (cancelled 'queue_expired'; 0 = never), unanswered QA reviews, the by-job
# re-check of unconfirmed rows, rows of finished sessions.
# PAIR_LAUNCH_COLLECTING_TTL_MIN=15
# PAIR_LAUNCH_QUEUED_MAX_S=   # default 1800 with the runner off, 21600 with it on; 0 = never
# PAIR_LAUNCH_REVIEW_TTL_H=24
# PAIR_LAUNCH_UNCONFIRMED_RECHECK_H=24
# PAIR_LAUNCH_RETENTION_DAYS=14
# auto (default: true on QA, from NEW_RELIC_ENVIRONMENT / APP_ENV / the
# APP_BASE_URL host) | true | false — the QA contact review when the browser
# does not say.
# PAIR_LAUNCH_REQUIRE_REVIEW_DEFAULT=auto
# Kill switch for every JobDiva provisioning path (inline per-batch, the
# launch-session stage, /engage/re-provision). Set false for local end-to-end
# launches so they never write JobDiva.
# JOBDIVA_PROVISIONING_ENABLED=true

# --- Call recordings (S3, read-only playback in the Assess modal) ---
# Only used when ENVIRONMENT=production; pair-bot uploads to the same bucket.
# In production prefer an IAM role (instance/task role) and leave the static
# keys below unset; boto3 picks the role up automatically.
ENVIRONMENT=
# Required to enable the feature (alongside ENVIRONMENT=production) — the
# recordings endpoint stays disabled, returning recordings: [], until both are set.
S3_RECORDINGS_BUCKET=
S3_RECORDINGS_PREFIX=recordings/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Dev only: show a fake recording in the Assess modal (ignored when ENVIRONMENT=production)
MOCK_CALL_RECORDINGS=false
