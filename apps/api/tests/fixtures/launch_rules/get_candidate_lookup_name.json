{
  "function": "getCandidateLookupName",
  "cases": [
    {
      "name": "name",
      "input": {
        "candidate": {
          "name": "Jane Doe",
          "title": "Engineer"
        }
      },
      "expected": "Jane Doe"
    },
    {
      "name": "name squeezed",
      "input": {
        "candidate": {
          "name": "  Jane \n  Doe  "
        }
      },
      "expected": "Jane Doe"
    },
    {
      "name": "first + last",
      "input": {
        "candidate": {
          "firstName": "Jane",
          "lastName": "Doe"
        }
      },
      "expected": "Jane Doe"
    },
    {
      "name": "first only",
      "input": {
        "candidate": {
          "firstName": "Jane",
          "lastName": ""
        }
      },
      "expected": "Jane"
    },
    {
      "name": "placeholder name falls to first + last",
      "input": {
        "candidate": {
          "name": "LinkedIn Candidate",
          "firstName": "Jane",
          "lastName": "Doe"
        }
      },
      "expected": "Jane Doe"
    },
    {
      "name": "placeholder, any case",
      "input": {
        "candidate": {
          "name": "UNKNOWN"
        }
      },
      "expected": ""
    },
    {
      "name": "title is never a name",
      "input": {
        "candidate": {
          "title": "Senior Java Developer",
          "source": "LinkedIn"
        }
      },
      "expected": ""
    },
    {
      "name": "nothing",
      "input": {
        "candidate": {}
      },
      "expected": ""
    },
    {
      "name": "no row",
      "input": {
        "candidate": null
      },
      "expected": ""
    },
    {
      "name": "numeric name",
      "input": {
        "candidate": {
          "name": 42
        }
      },
      "expected": "42"
    },
    {
      "name": "placeholder first+last",
      "input": {
        "candidate": {
          "firstName": "Unknown",
          "lastName": "Candidate"
        }
      },
      "expected": ""
    }
  ]
}
