{
  "function": "isServerPlaceholderEmail",
  "cases": [
    {
      "name": "empty",
      "input": {
        "value": ""
      },
      "expected": true
    },
    {
      "name": "null",
      "input": {
        "value": null
      },
      "expected": true
    },
    {
      "name": "not a string",
      "input": {
        "value": 12345
      },
      "expected": true
    },
    {
      "name": "no at",
      "input": {
        "value": "jane.acme.com"
      },
      "expected": true
    },
    {
      "name": "real",
      "input": {
        "value": "jane@acme.com"
      },
      "expected": false
    },
    {
      "name": "real, mixed case and padded",
      "input": {
        "value": " Jane@Acme.COM\t"
      },
      "expected": false
    },
    {
      "name": "listed placeholder",
      "input": {
        "value": "your-email@example.com"
      },
      "expected": true
    },
    {
      "name": "example.com",
      "input": {
        "value": "jane@example.com"
      },
      "expected": true
    },
    {
      "name": "example.org",
      "input": {
        "value": "jane@example.org"
      },
      "expected": true
    },
    {
      "name": "example.net",
      "input": {
        "value": "jane@example.net"
      },
      "expected": true
    },
    {
      "name": "test.com",
      "input": {
        "value": "jane@test.com"
      },
      "expected": true
    },
    {
      "name": "invalid domain",
      "input": {
        "value": "jane@invalid"
      },
      "expected": true
    },
    {
      "name": "localhost",
      "input": {
        "value": "jane@localhost"
      },
      "expected": true
    },
    {
      "name": "bare local domain",
      "input": {
        "value": "jane@local"
      },
      "expected": true
    },
    {
      "name": ".local subdomain",
      "input": {
        "value": "jane@jobdiva.local"
      },
      "expected": true
