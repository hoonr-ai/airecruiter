    {
      "name": "local part test",
      "input": {
        "value": "test@gmail.com"
      },
      "expected": true
    },
    {
      "name": "local part email",
      "input": {
        "value": "email@acme.com"
      },
      "expected": true
    },
    {
      "name": "local part example",
      "input": {
        "value": "example@acme.com"
      },
      "expected": true
    },
    {
      "name": "local part candidate",
      "input": {
        "value": "Candidate@acme.com"
      },
      "expected": true
    },
    {
      "name": "local part your-email",
      "input": {
        "value": "your-email@acme.com"
      },
      "expected": true
    },
    {
      "name": "local part your_email",
      "input": {
        "value": "your_email@acme.com"
      },
      "expected": true
