{
  "function": "isValidLaunchPhone",
  "cases": [
    {
      "name": "formatted",
      "input": {
        "value": "(408) 555-1234"
      },
      "expected": true
    },
    {
      "name": "e164",
      "input": {
        "value": "+1 408 555 1234"
      },
      "expected": true
    },
    {
      "name": "empty",
      "input": {
        "value": ""
      },
      "expected": false
    },
    {
      "name": "null",
      "input": {
        "value": null
      },
      "expected": false
    },
    {
      "name": "number",
      "input": {
        "value": 4085551234
      },
      "expected": true
    },
    {
      "name": "arabic-indic digits are not \\d",
      "input": {
        "value": "\u0664\u0660\u0668\u0665\u0665\u0665\u0661\u0662\u0663\u0664"
      },
      "expected": false
    },
    {
      "name": "letters",
      "input": {
        "value": "abc"
      },
      "expected": false
    },
    {
      "name": "seven digits",
      "input": {
        "value": "555-1234"
      },
      "expected": true
    },
    {
      "name": "six digits",
      "input": {
        "value": "55-1234"
      },
      "expected": false
    },
    {
      "name": "fullwidth digits",
      "input": {
        "value": "\uff14\uff10\uff18\uff15\uff15\uff15\uff11\uff12\uff13\uff14"
      },
      "expected": false
    },
    {
      "name": "float number",
      "input": {
        "value": 4085551234
      },
      "expected": true
    },
    {
      "name": "boolean",
      "input": {
        "value": true
      },
      "expected": false
    }
  ]
}
